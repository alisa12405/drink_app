# Smart Drink production environment
# Copy to .env, replace every secret, and never commit the resulting file.

APP_NAME="Smart Drink"
APP_URL=https://drinks.hmmh.click

# Cloudflare remotely managed tunnel; public hostname must route to http://site:80.
CLOUDFLARE_TUNNEL_TOKEN=

# MySQL is private to the Docker network. Use strong production passwords.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=drink_app
DB_USERNAME=drink_app
DB_PASSWORD=change_me_secret
DB_ROOT_PASSWORD=change_me_root_secret

# Redis is private to the Docker network.
REDIS_HOST=redis
REDIS_PORT=6379

# External services
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_RERANK_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=10
OPENAI_RERANK_TIMEOUT=15

WEATHER_API_PROVIDER=openweather
WEATHER_API_KEY=
WEATHER_TIMEOUT=3
WEATHER_CACHE_TTL=1800

RECOMMENDATION_TIMEZONE=Asia/Ho_Chi_Minh
RECOMMENDATION_RATE_LIMIT_PER_MINUTE=5
