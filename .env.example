# ==== Docker Compose environment (Smart Drink Recommendation App) ====
# Copy file nay thanh ".env" ("cp .env.example .env") truoc khi chay docker compose.
# File nay chi phuc vu ha tang Docker; sau khi cai Laravel, backend/.env se tach rieng
# va tham chieu cung DB_* / REDIS_* de khop voi cac service duoi day.

# ---- App / Ports ----
APP_NAME=drink-app
APP_HTTP_PORT=8080
FRONTEND_PORT=5174

# ---- MySQL (theo muc 2.2 SPEC: users, drinks, orders, ...) ----
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=drink_app
DB_USERNAME=drink_app
DB_PASSWORD=change_me_secret
DB_ROOT_PASSWORD=change_me_root_secret
# Doi port ngoai (host) neu may ban da co MySQL/service khac chiem 3306
DB_EXTERNAL_PORT=3307

# ---- Redis (cache: weather, embeddings - muc 2.5, 3) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379

# ---- phpMyAdmin (tien ich dev, khong bat buoc) ----
PHPMYADMIN_PORT=8082

# ---- OpenAI / Weather API (dung trong backend/.env sau khi cai Laravel) ----
OPENAI_API_KEY=
WEATHER_API_KEY=
